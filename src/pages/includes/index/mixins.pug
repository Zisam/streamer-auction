mixin icon(icon, name)
  svg(class= icon aria-hidden="true"): use(xlink:href="img/sprite.svg#" + name)

mixin auc-item(modif)
  .auc__item(class= modif)
    input.auc__lot(type="text" title="名前 / Name" placeholder="名前 / Name" autocomplete="off")
    input.auc__total-sum(type="text" inputmode="decimal" readonly tabindex="-1" title="合計（自動） / Total (auto)" placeholder="0")
    input.auc__current-sum(type="text" inputmode="decimal" title="今回の入札 / Bid to add" placeholder="+金額 / Amount" autocomplete="off")
    button.auc__add-sum(type="button" add-sum title="合計に加算 / Add to total"): +icon("auc__icon", "plus")
