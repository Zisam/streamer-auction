mixin icon(icon, name)
  svg(class= icon): use(xlink:href="img/sprite.svg#" + name)

mixin auc-item(modif)
  .auc__item(class= modif)
    input.auc__lot(type="text" title="ロット名 / Lot name" placeholder="名前 / Name")
    input.auc__total-sum(type="text" inputmode="decimal" oninput="this.value=this.value.replace(/[^0-9.]/g,'');" title="合計 / Total" placeholder="合計")
    input.auc__current-sum(type="text" inputmode="decimal" oninput="this.value=this.value.replace(/[^0-9.]/g,'');" title="入札額 / Bid" placeholder="入札")
    button.auc__add-sum(add-sum title="加算 / Add bid"): +icon("auc__icon", "plus")
